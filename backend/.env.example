# Server
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed origins for CORS (only needed if the frontend is served from a different domain).
CORS_ORIGINS=https://englishtherapy.com.bd,https://www.englishtherapy.com.bd

# Where the built frontend lives (relative to the backend folder). Leave as-is for the default monorepo layout.
FRONTEND_DIST=../frontend/dist

# Local JSON storage for leads and orders (relative to the backend folder).
DATA_DIR=./data

# Optional: forward every submission to a Google Apps Script web app (Google Sheets).
# Leave empty to disable forwarding.
GOOGLE_SCRIPT_URL=

# Optional: shared secret required to read submissions via GET /api/leads and GET /api/orders.
ADMIN_API_KEY=change-me
